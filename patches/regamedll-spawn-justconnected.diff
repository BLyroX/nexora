diff --git a/regamedll/dlls/player.cpp b/regamedll/dlls/player.cpp
index 25b538e..dacd2a5 100644
--- a/regamedll/dlls/player.cpp
+++ b/regamedll/dlls/player.cpp
@@ -6049,6 +6049,22 @@ void EXT_FUNC CBasePlayer::__API_HOOK(Spawn)()
 
 	m_lastx = m_lasty = 0;
 
+	// If a real gameplay spawn is forced while the joining state machine has not
+	// yet reached GetIntoGame() (e.g. a round-restart respawn firing right after
+	// JoinTeam set the player to GETINTOGAME), the player would otherwise end up
+	// alive but unarmed: PlayerSpawn's OnSpawnEquip is skipped while
+	// m_bJustConnected, and OnSpawnEquip skips GiveDefaultItems while m_bNotKilled
+	// -> no weapon, no ammo HUD, cannot fire until a team switch runs GetIntoGame.
+	// Treat such a spawn as a regular in-game spawn instead. The connect-time no-op
+	// spawn (m_iJoiningState == PICKINGTEAM) keeps its guarded behaviour.
+	if (m_bJustConnected && m_iJoiningState != PICKINGTEAM
+		&& (m_iTeam == CT || m_iTeam == TERRORIST))
+	{
+		m_bJustConnected = false;
+		m_bNotKilled = false;
+		m_iJoiningState = JOINED;
+	}
+
 	g_pGameRules->PlayerSpawn(this);
 
 	m_bNotKilled = true;
