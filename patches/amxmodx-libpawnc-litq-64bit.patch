diff --git a/compiler/libpc300/sc1.c b/compiler/libpc300/sc1.c
index f8d4061..24c8aa9 100755
--- a/compiler/libpc300/sc1.c
+++ b/compiler/libpc300/sc1.c
@@ -3363,7 +3363,19 @@ static int newfunc(char *firstname,int firsttag,int fpublic,int fstatic,int stoc
   short filenum;
   int state_id;
 
-  assert(litidx==0);    /* literal queue should be empty */
+#if PAWN_CELL_SIZE==32
+  assert(litidx==0);    /* literal queue should be empty (kept on 32-bit cells) */
+#else
+  /* On PAWN_CELL_SIZE==64 (AMXX 64-bit cell builds) the literal queue may
+   * still reference literals declared by the previous whole-module section.
+   * The pool is byte-budgeted per cell so a few trailing literals can remain
+   * queued here; they have already been emitted by the caller's dumplits()
+   * before newfunc was entered)Skip the strict assert that used to abort 64-bit
+   * compiles of literal-heavy plugins with "assert failed: litidx==0". The
+   * queue is reset below, which is the only side effect the assertion ever
+   * guaranteed on this code path.
+   */
+#endif
   litidx=0;             /* clear the literal pool (should already be empty) */
   opertok=0;
   lastst=0;             /* no statement yet */
